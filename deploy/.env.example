# Copy these into Dokploy → your application → Environment.
# Do not commit a filled-in copy.

# The domain Traefik serves this on. Also the only trusted Host authority.
DSH_PUBLIC_HOST=harness.example.com

# Extra authorities, space separated. Usually empty.
DSH_EXTRA_TRUSTED_HOSTS=

DSH_AUTH_USER=admin

# Generate with:  node deploy/hash-password.mjs
# Paste the whole line it prints. Leave empty and the container prints a random
# one-time password on each boot; paste a placeholder and the boot fails loudly.
# The digest is dot-separated on purpose: Compose expands $name inside a .env
# value, so a $-separated digest would arrive truncated to "scrypt".
DSH_AUTH_PASSWORD_HASH=scrypt.PASTE_REAL_DIGEST_HERE

# Optional bearer token for scripts/API clients. 16+ chars.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DSH_AUTH_API_TOKEN=

# Session lifetime. Sessions are in-process, so a redeploy signs everyone out regardless.
DSH_SESSION_TTL_HOURS=168

# Commit identity for agents working in /workspace.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
