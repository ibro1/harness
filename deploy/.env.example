# Copy these into Dokploy → your application → Environment.
# Do not commit a filled-in copy.

# The domain Traefik serves this on. Also the only trusted Host authority.
DSH_PUBLIC_HOST=harness.example.com

# Extra authorities, space separated. Usually empty.
DSH_EXTRA_TRUSTED_HOSTS=

DSH_AUTH_USER=admin

# Your password, in plain text. Avoid $ in it: Compose expands $name inside a
# .env value and would eat part of your password.
DSH_AUTH_PASSWORD=

# Optional alternative to the line above, so the plaintext never sits in
# Dokploy's database. Generate with `node deploy/hash-password.mjs` and paste
# the whole line it prints. Set one or the other, not both.
# DSH_AUTH_PASSWORD_HASH=

# With neither set, the container prints a random password on every boot.

# Optional bearer token for scripts/API clients. 16+ chars.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DSH_AUTH_API_TOKEN=

# Session lifetime. Sessions are in-process, so a redeploy signs everyone out regardless.
DSH_SESSION_TTL_HOURS=168

# Commit identity for agents working in /workspace.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Lets agents clone, pull and push. Without it they can only edit files they
# create themselves. A GitHub fine-grained PAT scoped to the repos you want
# reached; avoid $ in it, as with every value here.
GIT_TOKEN=
# Leave blank for GitHub. GitLab wants oauth2; Bitbucket wants your username.
GIT_TOKEN_USER=
# Leave blank for github.com.
GIT_HOST=

# --- GitHub webhook ingress (optional) -------------------------------------
# Set the secret to enable it; leave blank and no endpoint exists at all.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DSH_GITHUB_WEBHOOK_SECRET=
# Repositories allowed to trigger work, comma separated: owner/name,owner/other
DSH_GITHUB_REPOSITORIES=
# Directory holding one checkout per repository, named after the repo.
DSH_GITHUB_WORKSPACE_ROOT=/workspace
# Leading word marking a comment as a command.
DSH_GITHUB_TRIGGER=/dsh
# Port Traefik routes /github to inside the container. Change it only together
# with the harness-webhook Traefik label in docker-compose.yml; the entrypoint
# refuses to start if it collides with another port in the container.
DSH_GITHUB_WEBHOOK_PUBLIC_PORT=3083
# GitHub author associations permitted to trigger work. Never add NONE.
DSH_GITHUB_ALLOWED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
DSH_GITHUB_AGENT_PRESET=standard
# read-only | workspace-write | danger-full-access
DSH_GITHUB_PERMISSION_PRESET=read-only

# --- Browser control (optional) --------------------------------------------
# Lets an agent drive your browser through a Chrome extension you install.
# Set the token to enable it; leave blank and no bridge endpoint exists.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Treat it like a password: whoever holds it can drive your browser.
DSH_BROWSER_BRIDGE_TOKEN=
# Upgrade path the extension connects to. Leave blank for /browser-bridge.
DSH_BROWSER_BRIDGE_PATH=
# Set to 0 to stop registering the browser tools with the agy CLI over MCP.
# They are what lets a model reached through agy or opencode drive the browser
# at all: those CLIs run their own agent loop and ignore the harness's tools.
DSH_BROWSER_MCP=1
# Dokploy control. On by default; servers are added under Settings -> dokploy.
# Set to 0 to leave the plugin out.
DSH_DOKPLOY=1
# Each Dokploy server names an env var holding its API key (the apiKeyEnv field
# in Settings -> dokploy). Add that variable here and to docker-compose.yml so it
# reaches the container, e.g. DOKPLOY_KEY_MAIN=xxxxx
