# Copy these into Dokploy → your application → Environment.
# Do not commit a filled-in copy.

# The domain Traefik serves this on. Also the only trusted Host authority.
DSH_PUBLIC_HOST=harness.example.com

# Extra authorities, space separated. Usually empty.
DSH_EXTRA_TRUSTED_HOSTS=

DSH_AUTH_USER=admin

# Your password, in plain text. Avoid $ in it: Compose expands $name inside a
# .env value and would eat part of your password.
DSH_AUTH_PASSWORD=

# Optional alternative to the line above, so the plaintext never sits in
# Dokploy's database. Generate with `node deploy/hash-password.mjs` and paste
# the whole line it prints. Set one or the other, not both.
# DSH_AUTH_PASSWORD_HASH=

# With neither set, the container prints a random password on every boot.

# Optional bearer token for scripts/API clients. 16+ chars.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DSH_AUTH_API_TOKEN=

# Session lifetime. Sessions are in-process, so a redeploy signs everyone out regardless.
DSH_SESSION_TTL_HOURS=168

# Commit identity for agents working in /workspace.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Lets agents clone, pull and push. Without it they can only edit files they
# create themselves. A GitHub fine-grained PAT scoped to the repos you want
# reached; avoid $ in it, as with every value here.
GIT_TOKEN=
# Leave blank for GitHub. GitLab wants oauth2; Bitbucket wants your username.
GIT_TOKEN_USER=
# Leave blank for github.com.
GIT_HOST=

# --- GitHub webhook ingress (optional) -------------------------------------
# Set the secret to enable it; leave blank and no endpoint exists at all.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DSH_GITHUB_WEBHOOK_SECRET=
# Repositories allowed to trigger work, comma separated: owner/name,owner/other
DSH_GITHUB_REPOSITORIES=
# Directory holding one checkout per repository, named after the repo.
DSH_GITHUB_WORKSPACE_ROOT=/workspace
# Leading word marking a comment as a command.
DSH_GITHUB_TRIGGER=/dsh
# Port Traefik routes /github to inside the container. Change it only together
# with the harness-webhook Traefik label in docker-compose.yml; the entrypoint
# refuses to start if it collides with another port in the container.
DSH_GITHUB_WEBHOOK_PUBLIC_PORT=3083
# GitHub author associations permitted to trigger work. Never add NONE.
DSH_GITHUB_ALLOWED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
DSH_GITHUB_AGENT_PRESET=standard
# read-only | workspace-write | danger-full-access
DSH_GITHUB_PERMISSION_PRESET=read-only

# --- Browser control (optional) --------------------------------------------
# Lets an agent drive your browser through a Chrome extension you install.
# Set the token to enable it; leave blank and no bridge endpoint exists.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Treat it like a password: whoever holds it can drive your browser.
DSH_BROWSER_BRIDGE_TOKEN=
# Upgrade path the extension connects to. Leave blank for /browser-bridge.
DSH_BROWSER_BRIDGE_PATH=
# Set to 0 to stop registering the browser tools with the agy CLI over MCP.
# They are what lets a model reached through agy or opencode drive the browser
# at all: those CLIs run their own agent loop and ignore the harness's tools.
DSH_BROWSER_MCP=1
# Dokploy control. On by default; servers are added under Settings -> dokploy.
# Set to 0 to leave the plugin out.
DSH_DOKPLOY=1
# Each Dokploy server names an env var holding its API key (the apiKeyEnv field
# in Settings -> dokploy). Add that variable here and to docker-compose.yml so it
# reaches the container, e.g. DOKPLOY_KEY_MAIN=xxxxx
# Token guarding the Dokploy MCP command route. Set it (any long random string)
# to give the agy/opencode CLI models the Dokploy tools; leave blank and only
# direct-provider models get them. Generate: openssl rand -base64 32
DSH_DOKPLOY_TOKEN=

# --- DeerFlow remote browser (optional) ------------------------------------
# Attaches the external DeerFlow headless-browser MCP server so its 23 browser
# tools appear to the agent as mcp__deerflow__*. Set the token to enable it;
# leave blank and no tools are attached. The operator supplies the token — it is
# never committed. Treat it like a password: it drives a live browser.
DEERFLOW_BROWSER_MCP_TOKEN=
# Optional endpoint override; defaults to https://deer.linkfa.de/mcp/browser
DEERFLOW_BROWSER_MCP_URL=
# Direct-provider models get the DeerFlow tools natively; the agy/opencode CLIs
# drop native tools, so they are also registered with those CLIs over MCP. Set
# to 0 to withhold them from the CLIs (and, for agy, the
# --dangerously-skip-permissions grant that admits them).
DEERFLOW_BROWSER_MCP=1

# --- video-use skill: transcription (optional) -----------------------------
# The baked-in video-use editor transcribes footage before cutting. Set at
# least one key to enable it. transcribe.py auto-selects diarizing providers
# first: deepgram > assemblyai > elevenlabs > groq > openai. Force one with
# TRANSCRIBE_PROVIDER.
# Deepgram (word timestamps + diarization + fillers; generous free credit):
# https://console.deepgram.com
DEEPGRAM_API_KEY=
# AssemblyAI (word timestamps + diarization + disfluencies): https://assemblyai.com
ASSEMBLYAI_API_KEY=
# Groq Whisper (free, generous; word timestamps, NO diarization/fillers):
# https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI Whisper (word timestamps, no diarization/fillers): platform.openai.com
OPENAI_API_KEY=
# ElevenLabs Scribe (diarization + audio-event/filler tags):
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Force a provider: deepgram | assemblyai | elevenlabs | groq | openai
TRANSCRIBE_PROVIDER=

# --- video-use skill: text-to-speech / voiceover (optional) ----------------
# speak.py generates voiceovers. Gemini (default) gives prompt-steered accents
# (incl. Nigerian) — accent, tone and pace come from the --style prompt, not a
# parameter. Durable key (starts AIzaSy, 39 chars): https://aistudio.google.com/apikey
# An AQ.-prefixed string is an ephemeral browser session token, not a real key.
# Free tier uses prompts/outputs for product improvement — flag before client work.
# (ELEVENLABS_API_KEY above is the second TTS provider.)
GEMINI_API_KEY=

# --- video-use skill: source downloads (optional) --------------------------
# download.py fetches a video/audio/transcript from a URL (YouTube et al.) for
# editing. YouTube bot-gates datacenter IPs, so it needs fresh account cookies.
# Point these at the DeerFlow cookie endpoint (bearer-gated), which re-exports a
# fresh jar continuously. Without them, only non-gated URLs will download.
YT_COOKIES_URL=https://deer.linkfa.de/yt/cookies.txt
YT_COOKIES_TOKEN=
# Alternatively, a path to a Netscape cookies.txt on a mounted volume:
YT_COOKIES_FILE=

# --- LLM gateway (optional) ---
# Lets another service on this box use this harness's models. The agy and
# opencode bridges already speak the OpenAI protocol but bind loopback with NO
# auth of their own, so they must never be given a domain; this token is the one
# authenticated door to them:
#   POST /llm/agy/v1/chat/completions        GET /llm/agy/v1/models
#   POST /llm/opencode/v1/chat/completions   GET /llm/opencode/v1/models
# Deliberately NOT DSH_AUTH_API_TOKEN: that grants the whole harness (sessions,
# shell, workspace), and a caller that only needs completions should not hold
# it. A leaked gateway token costs model quota, not the box.
# Minimum 16 characters; unset leaves the routes unregistered.
#   openssl rand -hex 24
DSH_LLM_GATEWAY_TOKEN=
# Where the bridges listen, if you moved them.
# AGY_BRIDGE_URL=http://127.0.0.1:8001
# OPENCODE_BRIDGE_URL=http://127.0.0.1:8002
# A bridge spawns a CLI per request, so the ceiling is minutes, not seconds.
# DSH_LLM_GATEWAY_TIMEOUT_MS=600000

# --- WhatsApp for another service on this box (optional) ---
# The sidecar holds many accounts, one per session key, so a multi-tenant app
# can link a separate phone per tenant. This token opens /whatsapp/api/* for
# that app. It is NOT WA_AGENT_TOKEN (this harness's own agent) and NOT
# DSH_AUTH_API_TOKEN (the whole harness) — holding it grants WhatsApp sessions
# and nothing else. Unset leaves the routes unregistered.
#   openssl rand -hex 24
WA_EXTERNAL_TOKEN=
# The session the settings card and the agent drive. External callers must name
# a session and are refused this one, so no tenant can act as, or read, the
# operator's own linked phone.
# WA_DEFAULT_SESSION=default
