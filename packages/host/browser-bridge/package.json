{
  "name": "@deepseek-ai/dsh-host-browser-bridge",
  "description": "Fork-local browser control: a signed WebSocket bridge a browser extension connects to, and the agent tools that drive it",
  "version": "0.1.2-rc.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
