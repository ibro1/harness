      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-host-capture": "workspace:*",
    "@deepseek-ai/dsh-host-employee-kit": "workspace:*",
    "@deepseek-ai/dsh-host-seo-employee": "workspace:*",
