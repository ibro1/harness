{
  "name": "@deepseek-ai/dsh-host-meeting-reminders",
  "description": "Fork-local meeting reminders: posts recurring WhatsApp reminders of monthly meetings to group chats, with the Hijri date as the main date",
  "version": "0.1.2-rc.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ]
}
